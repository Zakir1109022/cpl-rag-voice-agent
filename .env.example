# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Agent dispatch name. Empty = automatic dispatch. Non-empty enables explicit
# dispatch and MUST match AGENT_NAME in frontend/.env.local (e.g. cpl-local).
AGENT_NAME=

# Groq (LLM)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# Qdrant Cloud (leave qdrant_url empty for local path)
QDRANT_URL=https://your-cluster.qdrant.io:6333
QDRANT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Ingestion / retrieval
DOCS_DIR=docs
EMBEDDING_MODEL=all-MiniLM-L6-v2
COLLECTION_NAME=telecom_docs
CHUNK_SIZE=500

# Voice models
STT_MODEL=deepgram/nova-3
STT_LANGUAGE=multi
TTS_MODEL=inworld/inworld-tts-2
TTS_VOICE=Ashley

# Browser tools (Playwright / Chromium)
# Master switch. When 0, the browser_* LangChain tools are not registered.
BROWSER_ENABLED=1
# Run Chromium headless. Set 0 to run with a window (dev only).
BROWSER_HEADLESS=1
# Max concurrent LiveKit rooms holding a BrowserContext (LRU-evict oldest).
BROWSER_MAX_CONTEXTS=8
# Seconds of inactivity before an idle room's context is reset.
BROWSER_IDLE_TIMEOUT_S=300
# Comma-separated glob list of allowed domains (e.g. "*.cplphones.com,example.com").
# Empty = allow all + emit a one-time warning at startup.
BROWSER_ALLOWED_DOMAINS=
# Set 1 to permit navigation to private IP ranges (10/8, 192.168/16, etc.).
# Default 0 (SSRF block).
BROWSER_ALLOW_PRIVATE=0
# Permit the browser_evaluate tool to run arbitrary JavaScript.
BROWSER_ALLOW_EVAL=1
# Default navigation and per-action timeouts in milliseconds.
BROWSER_DEFAULT_TIMEOUT_MS=15000
BROWSER_ACTION_TIMEOUT_MS=5000
# Viewport and locale.
BROWSER_VIEWPORT_W=1280
BROWSER_VIEWPORT_H=720
BROWSER_LOCALE=en-IN
BROWSER_TIMEZONE=Asia/Kolkata
# Override Chromium User-Agent. Empty = Playwright default.
BROWSER_USER_AGENT=
# HTTP/SOCKS proxy URL. Empty = direct.
BROWSER_PROXY=
# Sandboxed download directory.
BROWSER_DOWNLOAD_DIR=/tmp/browser_downloads
# Max browser_* tool calls per voice turn before the cap trips.
BROWSER_MAX_ACTIONS_PER_TURN=25